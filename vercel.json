{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "api/meta.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/admin/configuracao.html",
      "destination": "/admin/configuracao.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/api/meta"
    }
  ]
}
